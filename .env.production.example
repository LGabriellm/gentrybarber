# Production environment template.
# Copy to .env.production on the VPS and fill in real values.
# NEVER commit .env.production to Git.

NODE_ENV=production

# ── Platform identity ────────────────────────────────────────────
PLATFORM_NAME=GentryBarber
PLATFORM_DOMAIN=localhost

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Auth ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
BETTER_AUTH_URL=http://187.77.235.234:4000
TRUSTED_ORIGINS=http://187.77.235.234:3001,http://187.77.235.234:3002

# ── API ──────────────────────────────────────────────────────────
API_URL=http://187.77.235.234:4000
NEXT_PUBLIC_API_URL=http://187.77.235.234:4000
ADMIN_URL=http://187.77.235.234:3002
API_PORT=4000
BIND_HOST=0.0.0.0

# ── Reverse proxy trust ─────────────────────────────────────────
# When using Caddy with a domain, set the Docker bridge CIDR.
# TRUST_PROXY_CIDRS=172.16.0.0/12
TRUST_PROXY_CIDRS=

# ── Rate limiting (shared Redis) ────────────────────────────────
RATE_LIMIT_NAMESPACE=platform:http:
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ── SMTP (real mail delivery) ───────────────────────────────────
# Configure with your SMTP provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Plataforma <noreply@example.com>
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_MODE=live

# ── Storage (S3 compatible — optional, leave empty to skip) ─────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=platform

# ── Demo mode ───────────────────────────────────────────────────
DEMO_MODE=false
