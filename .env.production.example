# Production environment template.
# Copy to .env.production on the VPS and fill in real values.
# NEVER commit .env.production to Git.

NODE_ENV=production

# ── Platform identity ────────────────────────────────────────────
PLATFORM_NAME=GentryBarber
PLATFORM_DOMAIN=gentryhub.tech

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Auth ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://api.gentryhub.tech
TRUSTED_ORIGINS=https://dashboard.gentryhub.tech,https://admin.gentryhub.tech

# ── API ──────────────────────────────────────────────────────────
ADMIN_URL=https://admin.gentryhub.tech
API_PORT=4000
BIND_HOST=0.0.0.0
API_HOST_PORT=4000
WEB_PUBLIC_HOST_PORT=3000
DASHBOARD_HOST_PORT=3001
ADMIN_HOST_PORT=3002

# ── Reverse proxy trust ─────────────────────────────────────────
# Leave empty on the first deploy. deploy.sh records only the exact Docker
# gateway (/32) used by host Caddy. Never use 0.0.0.0/0 or a broad private range.
TRUST_PROXY_CIDRS=

# ── Rate limiting (shared Redis) ────────────────────────────────
RATE_LIMIT_NAMESPACE=platform:http:
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ── SMTP (real mail delivery) ───────────────────────────────────
# Configure with your SMTP provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Plataforma <noreply@example.com>
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_MODE=live

# ── Storage (S3 compatible — optional, leave empty to skip) ─────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=platform

# ── Demo mode ───────────────────────────────────────────────────
DEMO_MODE=false
