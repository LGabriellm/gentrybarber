# Rendered by infra/vps/deploy.sh. The placeholder is replaced with PLATFORM_DOMAIN.
# This first production ingress is intentionally HTTP-only. Wildcard HTTPS requires
# DNS-01 or guarded on-demand TLS and must be introduced with the domain adapter.

http://*.{{PLATFORM_DOMAIN}} {
	reverse_proxy 127.0.0.1:3000
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode gzip zstd
}

http://{{PLATFORM_DOMAIN}}, http://www.{{PLATFORM_DOMAIN}} {
	respond "Barber Platform is running. Use the address of a published barbershop." 200
}

:80 {
	respond "Unknown host" 404
}
