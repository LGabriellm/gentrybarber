# Local only. Generate BETTER_AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PLATFORM_NAME=BarberHub
PLATFORM_DOMAIN=localhost
DATABASE_URL=postgresql://platform:local_platform_password@localhost:5432/platform
DATABASE_TEST_URL=postgresql://platform:local_platform_password@localhost:5432/platform_test
POSTGRES_PASSWORD=local_platform_password
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
BIND_HOST=127.0.0.1
# Production only: exact IPs/CIDRs of your reverse proxy, never all networks.
TRUST_PROXY_CIDRS=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Platform <noreply@localhost>
SMTP_USER=
SMTP_PASSWORD=
# Server-only tenant ID -> Meta account mapping; see docs/WHATSAPP.md.
# Empty means no account connected. Never use NEXT_PUBLIC_ for these values.
WHATSAPP_ACCOUNTS_JSON=
WHATSAPP_GRAPH_VERSION=
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=local_minio_password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=platform
# Explicit, nonproduction-only preview fixtures, no authentication bypass.
DEMO_MODE=false
