{
  "name": "barber-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm db:generate && turbo build",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "pnpm db:generate && tsc --noEmit && turbo typecheck",
    "test": "vitest run --config vitest.config.ts --configLoader native",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts --configLoader native",
    "test:e2e": "playwright test",
    "test:e2e:catalog": "node --import ./scripts/load-env.mjs node_modules/@playwright/test/cli.js test --config playwright.catalog.config.ts",
    "db:generate": "pnpm --filter @platform/database db:generate",
    "db:migrate": "pnpm --filter @platform/database db:migrate",
    "db:seed": "pnpm --filter @platform/database db:seed",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "access:grant": "node --env-file-if-exists=.env --import tsx scripts/grant-access.ts",
    "test:runtime": "node --env-file-if-exists=.env scripts/smoke-build.mjs",
    "db:migrate:test": "node --env-file-if-exists=.env scripts/migrate-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tsup": "8.5.1",
    "tsx": "^4.21.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0",
    "zod": "^4.3.0"
  },
  "volta": {
    "node": "24.20.0"
  }
}
