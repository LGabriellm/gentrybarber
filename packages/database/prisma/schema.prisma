  sizeBytes Int      @map("size_bytes")
  width     Int?
  height    Int?
  alt       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, objectKey])
  @@index([tenantId, position])
  @@map("gallery_assets")
}

model SocialLink {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  platform String
  url      String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, platform])
  @@map("social_links")
}

model Notification {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  recipient      String
  templateKey    String              @map("template_key")
  payload        Json
  idempotencyKey String              @unique @map("idempotency_key")
  attempts       Int                 @default(0)
  scheduledAt    DateTime            @default(now()) @map("scheduled_at") @db.Timestamptz(3)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  lastError      String?             @map("last_error")
  appointmentId  String?             @map("appointment_id")
  appointmentVersion Int?            @map("appointment_version")
  processingAt   DateTime?           @map("processing_at") @db.Timestamptz(3)
  providerMessageId String?          @map("provider_message_id")
  appointment Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, scheduledAt])
  @@index([channel, status, scheduledAt])
  @@map("notifications")
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  key       String
  channel   NotificationChannel
  subject   String?
  body      String
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, key, channel])
  @@map("notification_templates")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
