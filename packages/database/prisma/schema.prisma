model TimeOff {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  locationId     String        @map("location_id")
  professionalId String?       @map("professional_id")
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)
  professional   Professional? @relation(fields: [tenantId, locationId, professionalId], references: [tenantId, locationId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, locationId, startsAt, endsAt])
  @@index([tenantId, professionalId, startsAt, endsAt])
  @@map("time_offs")
}

model Customer {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  name         String
  phone        String
  email        String?
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  version      Int           @default(1)
  whatsappOptInAt DateTime? @map("whatsapp_opt_in_at") @db.Timestamptz(3)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, email])
  @@map("customers")
}

model Appointment {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  locationId     String               @map("location_id")
  professionalId String               @map("professional_id")
  customerId     String               @map("customer_id")
  status         AppointmentStatus    @default(PENDING)
  startsAt       DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime             @map("ends_at") @db.Timestamptz(3)
  totalCents     Int                  @map("total_cents")
  notes          String?
  idempotencyKey String?              @map("idempotency_key")
  requestHash    String?              @map("request_hash")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int                  @default(1)
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location             @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  professional   Professional         @relation(fields: [tenantId, locationId, professionalId], references: [tenantId, locationId, id], onDelete: Restrict)
  customer       Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  services       AppointmentService[]
  events         AppointmentEvent[]
  notifications  Notification[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, locationId, id])
  @@index([tenantId, locationId, startsAt])
  @@index([tenantId, professionalId, startsAt, endsAt])
  @@index([tenantId, customerId])
  @@map("appointments")
}

model AppointmentService {
  id              String      @id @default(cuid())
  tenantId        String      @map("tenant_id")
  locationId      String      @map("location_id")
  appointmentId   String      @map("appointment_id")
  serviceId       String      @map("service_id")
  name            String
  durationMinutes Int         @map("duration_minutes")
  priceCents      Int         @map("price_cents")
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location        Location    @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  appointment     Appointment @relation(fields: [tenantId, locationId, appointmentId], references: [tenantId, locationId, id], onDelete: Cascade)
  service         Service     @relation(fields: [tenantId, locationId, serviceId], references: [tenantId, locationId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, locationId, appointmentId])
  @@index([tenantId, locationId, serviceId])
  @@map("appointment_services")
}

model AppointmentEvent {
  id            String            @id @default(cuid())
  tenantId      String            @map("tenant_id")
  locationId    String            @map("location_id")
  appointmentId String            @map("appointment_id")
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus @map("to_status")
  reason        String?
  actorUserId   String?           @map("actor_user_id")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location          @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  appointment   Appointment       @relation(fields: [tenantId, locationId, appointmentId], references: [tenantId, locationId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, appointmentId, createdAt])
  @@index([tenantId, locationId])
  @@map("appointment_events")
}

model GalleryAsset {
